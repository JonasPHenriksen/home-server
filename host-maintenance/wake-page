def page(body, refresh=False):
    meta = '<meta http-equiv="refresh" content="10">' if refresh else ""
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">{meta}
<title>Wake</title><style>{CSS}</style></head>
<body><main>{body}</main></body></html>
""".encode()


def error_line(error):
    return f'<p class="err">{html.escape(error)}</p>' if error else ""


def login_page(error=""):
    return page(f"""<h1>Wake</h1>
<form method="post" action="/login" class="form">
<label>Password<input type="password" name="password" autocomplete="current-password" autofocus required></label>
<button>Log in</button></form>{error_line(error)}
<footer>New device? <a href="/ca.crt">Get the certificate</a> and trust it once, and the
browser stops warning here and on the other home sites (README, HTTPS for the home sites).</footer>""")


def main_page(machines, states, now, cert_until, error=""):
    cards = []
    for name, m in machines.items():
        s = states.get(name) or new_state()
        note, svcs = wake_note(s, now) or halt_note(s, now), services_line(s)
        # the button for what makes sense now is filled, the other one outlined
        wake = (f'<form method="post" action="/wake/{name}">'
                f'<button class="btn wake{" second" if s["on"] else ""}">Wake</button></form>')
        if m.get("shutdown"):
            halt = f'<a class="btn halt{"" if s["on"] else " second"}" href="/shutdown/{name}">Shut down</a>'
        else:       # not set up for this device: shown, but grey
            halt = '<button class="btn halt" disabled title="Not set up for this device">Shut down</button>'
        cards.append(f"""<section class="card">
<div class="info"><div><b>{html.escape(m['label'])}</b></div>
<div class="muted">{m['ip']}</div>
<div class="state">{state_html(s, now)}</div>{f'<div class="note">{note}</div>' if note else ''}\
{f'<div class="svcs">{svcs}</div>' if svcs else ''}
<div class="links muted"><a href="/edit/{name}">Edit</a> · <a href="/remove/{name}">Remove</a></div></div>
<div class="actions">{wake}{halt}</div>
</section>""")
    if not machines:
        cards.append('<p class="muted">No devices on the list.</p>')
    by_arp = [html.escape(m["label"]) for m in machines.values() if m["check"] == "arp"]
    how = ""
    if len(by_arp) == 1:
        how = f" {by_arp[0]} goes by ARP, since it ignores ping."
    elif by_arp:
        how = f" {', '.join(by_arp[:-1])} and {by_arp[-1]} go by ARP, since they ignore ping."
    cert = ""
    if cert_until:
        cert = f" Certificate valid until {day(cert_until)}."
        if cert_until - now < 30 * 86400:
            cards.append(f'<p class="note">The certificate runs out on {day(cert_until)}: '
                         'make new ones (README, HTTPS for the home sites).</p>')
    return page(f"""<h1>Wake</h1>
{''.join(cards)}{error_line(error)}
<p><a href="/add">+ Add a device</a></p>
<footer><p>Checked from the laptop every {CHECK_SECS:g} s.{how}{cert}</p>
<form method="post" action="/logout"><button class="btn logout">Log out</button></form></footer>""", refresh=True)


def device_form(action, button, values, error):
    v = {k: html.escape(values.get(k, "")) for k in ("label", "ip", "mac")}
    arp = values.get("check") == "arp"
    return f"""<form method="post" action="{action}" class="form">
<label>Name<input name="label" value="{v['label']}" maxlength="40" required autocomplete="off"></label>
<label>IP address<input name="ip" value="{v['ip']}" placeholder="192.168.50.23" inputmode="decimal" required
 autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"></label>
<label>MAC address <span class="muted">(leave it empty and the page looks it up, if the device is on now)</span>
<input name="mac" value="{v['mac']}" placeholder="02:00:00:00:00:20" autocomplete="off" autocorrect="off"
 autocapitalize="characters" spellcheck="false"></label>
<fieldset><legend>How the page tells it is on</legend>
<label class="choice"><input type="radio" name="check" value="ping"{'' if arp else ' checked'}>
 Ping: most devices</label>
<label class="choice"><input type="radio" name="check" value="arp"{' checked' if arp else ''}>
 ARP: a device that ignores ping, like a Windows PC</label></fieldset>{error_line(error)}
<p><button>{button}</button> &nbsp; <a href="/">Cancel</a></p></form>"""


def add_page(values=None, error=""):
    return page(f"""<h1>Add a device</h1>
{device_form("/add", "Add", values or {}, error)}
<footer>For a wake-up to work, Wake-on-LAN has to be on in the device's BIOS and network settings. Give it a
fixed IP address (a reservation in the router), since the page checks it at that address.</footer>""")


def edit_page(name, m, values=None, error=""):
    sites = " and ".join(html.escape(s) for s in (m.get("services") or {}))
    keep = f"\n<footer>Its checks of {sites} stay, and move along if the IP address changes.</footer>" if sites else ""
    return page(f"""<h1>Edit {html.escape(m['label'])}</h1>
{device_form(f"/edit/{name}", "Save", values or m, error)}{keep}""")


def remove_page(name, m):
    sites = " and ".join(html.escape(s) for s in (m.get("services") or {}))
    also = f" Its checks of {sites} go with it, and adding it again does not bring those back." if sites else ""
    return page(f"""<h1>Remove {html.escape(m['label'])}?</h1>
<p>It goes off this list; nothing happens to the device itself, and adding it again brings it back.{also}</p>
<form method="post" action="/remove/{name}"><p><button class="danger">Remove</button> &nbsp;
<a href="/">Cancel</a></p></form>""")


def shutdown_page(name, m, on=None):
    if on is False:
        return page(f"""<h1>{html.escape(m['label'])} is off</h1>
<p>The page sees it as off already, so there is nothing to shut down.</p>
<p><a href="/">Back</a></p>""")
    return page(f"""<h1>Shut down {html.escape(m['label'])}?</h1>
<p>It switches off the way its own shutdown does, so anything unsaved on it is lost. The Wake button brings it
back.</p>
<form method="post" action="/shutdown/{name}"><p><button class="danger">Shut down</button> &nbsp;
<a href="/">Cancel</a></p></form>""")


# --- the login -------------------------------------------------------------

def hash_password(password, salt=None):
    salt = salt or os.urandom(16)
    return f"scrypt${salt.hex()}${hashlib.scrypt(password.encode(), salt=salt, n=2**14, r=8, p=1).hex()}"


def password_ok(password, stored):
    kind, _, rest = stored.partition("$")
    salt, _, want = rest.partition("$")
    try:
        got = hashlib.scrypt(password.encode(), salt=bytes.fromhex(salt), n=2**14, r=8, p=1).hex()
    except ValueError:
        return False
    return kind == "scrypt" and hmac.compare_digest(got.encode(), want.encode())


def read_password():
    try:
        return (DIR / "password").read_text().strip()
    except OSError:
        return ""


def signature(secret, stored, expires):
    # Signed over the password hash too, so a new password logs every device out.
    return hmac.new(secret, f"{expires}${stored}".encode(), hashlib.sha256).hexdigest()


def make_cookie(secret, stored, now):
    expires = int(now) + SESSION_DAYS * 86400
    return f"{expires}.{signature(secret, stored, expires)}"


def cookie_ok(value, secret, stored, now):
    expires, _, sig = value.partition(".")
    if not re.fullmatch(r"[0-9]{1,12}", expires) or int(expires) <= now:
        return False
    return hmac.compare_digest(sig.encode(), signature(secret, stored, int(expires)).encode())


def load_secret():
    try:
        return bytes.fromhex((DIR / "secret").read_text().strip())
    except (OSError, ValueError):
        secret = os.urandom(32)
        write_private(DIR / "secret", secret.hex() + "\n")
        return secret


# --- the server ------------------------------------------------------------

COOKIE = "session={}; Max-Age={}; Path=/; Secure; HttpOnly; SameSite=Lax"
CSP = "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'"


class Handler(BaseHTTPRequestHandler):
    server_version = "wake-page"
    sys_version = ""
    timeout = 30

    def log_message(self, *args):
        pass        # the page reloads every 10 s; changes and wrong passwords are logged below

    def send(self, status, body=b"", ctype="text/html; charset=utf-8", headers=()):
        self.send_response(status)
        for k, v in [("Content-Type", ctype), ("Content-Length", str(len(body))),
                     ("Cache-Control", "no-store"), ("Content-Security-Policy", CSP), *headers]:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def redirect(self, where, headers=()):
        self.send(HTTPStatus.SEE_OTHER, headers=[("Location", where), *headers])

    def not_found(self):
        self.send(HTTPStatus.NOT_FOUND, b"Not found\n", "text/plain; charset=utf-8")

    def from_this_page(self):
        """Whether a form post comes from this page itself. Browsers count every
        port of the laptop as one site, so the cookie's SameSite does not keep
        the laptop's other pages (Pi-hole, MeTube, the camera page) from posting
        here; the Origin header, which no page can set, does. A client that
        sends neither Origin nor Referer is no browser, and still needs the login."""
        origin = self.headers.get("Origin")
        if origin is None:
            referer = self.headers.get("Referer")
            if referer is None:
                return True
            parts = urllib.parse.urlsplit(referer)
            origin = f"{parts.scheme}://{parts.netloc}"
        return origin.lower() == f"https://{self.headers.get('Host', '')}".lower()

    def logged_in(self):
        try:
            morsel = SimpleCookie(self.headers.get("Cookie", "")).get("session")
        except CookieError:
            return False
        stored = read_password()
        return bool(morsel and stored) and cookie_ok(morsel.value, self.server.secret, stored, time.time())

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/ca.crt":         # public by nature, and a new device needs it before logging in
            return self.send(HTTPStatus.OK, CA.read_bytes(), "application/x-x509-ca-cert")
        if path == "/login":
            return self.send(HTTPStatus.OK, login_page())
        if not self.logged_in():
            return self.redirect("/login")
        if path == "/":
            return self.send(HTTPStatus.OK, self.server.main_page())
        if path == "/add":
            return self.send(HTTPStatus.OK, add_page())
        if path.startswith("/shutdown/"):
            name = path.removeprefix("/shutdown/")
            m = self.server.watcher.machine(name)
            if not m or not m.get("shutdown"):
                return self.not_found()
            on = self.server.watcher.snapshot()[1].get(name, {}).get("on")
            return self.send(HTTPStatus.OK, shutdown_page(name, m, on))
        for prefix, page_for in (("/edit/", edit_page), ("/remove/", remove_page)):
            if path.startswith(prefix):
                name = path.removeprefix(prefix)
                m = self.server.watcher.machine(name)
                return self.send(HTTPStatus.OK, page_for(name, m)) if m else self.not_found()
        self.not_found()

    do_HEAD = do_GET

    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if not 0 <= length <= 4096:
            return self.send(HTTPStatus.BAD_REQUEST, b"Bad request\n", "text/plain; charset=utf-8")
        form = urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8", "replace"))
        if not self.from_this_page():
            log(f"refused a form from another page ({self.headers.get('Origin') or self.headers.get('Referer')}), "
                f"from {self.client_address[0]}")
            return self.send(HTTPStatus.FORBIDDEN, b"Forms are only taken from this page\n", "text/plain; charset=utf-8")
        if path == "/login":
            return self.login(form.get("password", [""])[0])
        if not self.logged_in():
            return self.redirect("/login")
        who = self.client_address[0]
        if path == "/logout":
            return self.redirect("/login", [("Set-Cookie", COOKIE.format("", 0))])
        if path == "/add":
            fields = {k: form.get(k, [""])[0] for k in ("label", "ip", "mac", "check")}
            try:
                _, m = self.server.watcher.add(**fields)
            except ValueError as e:
                return self.send(HTTPStatus.BAD_REQUEST, add_page(fields, str(e)))
            except OSError as e:
                return self.send(HTTPStatus.INTERNAL_SERVER_ERROR, add_page(fields, f"Could not save the list: {e}"))
            log(f"added {m['label']} ({m['ip']}, {m['mac']}, by {m['check']}), from {who}")
            return self.redirect("/")
        if path.startswith("/edit/"):
            name = path.removeprefix("/edit/")
            fields = {k: form.get(k, [""])[0] for k in ("label", "ip", "mac", "check")}
            try:
                old, new = self.server.watcher.edit(name, **fields)
            except LookupError:
                return self.not_found()
            except ValueError as e:
                m = self.server.watcher.machine(name) or {"label": fields["label"]}
                return self.send(HTTPStatus.BAD_REQUEST, edit_page(name, m, fields, str(e)))
            except OSError as e:
                m = self.server.watcher.machine(name) or {"label": fields["label"]}
                return self.send(HTTPStatus.INTERNAL_SERVER_ERROR,
                                 edit_page(name, m, fields, f"Could not save the list: {e}"))
            changes = ", ".join(f"{k} {old[k]} -> {new[k]}" for k in ("label", "ip", "mac", "check")
                                if old[k] != new[k])
            log(f"edited {old['label']}: {changes or 'nothing changed'}, from {who}")
            return self.redirect("/")
        if path.startswith("/remove/"):
            try:
                m = self.server.watcher.remove(path.removeprefix("/remove/"))
            except OSError as e:
                return self.send(HTTPStatus.INTERNAL_SERVER_ERROR, self.server.main_page(f"Could not save the list: {e}"))
            if m is None:
                return self.not_found()
            log(f"removed {m['label']} ({m['ip']}, {m['mac']}), from {who}")
            return self.redirect("/")
        if path.startswith("/shutdown/"):
            name = path.removeprefix("/shutdown/")
            m = self.server.watcher.machine(name)
            if not m or not m.get("shutdown"):
                return self.not_found()
            problem = shut_down(m["shutdown"], m["ip"])
            if problem is None:
                self.server.watcher.halted(name)
                log(f"shut-down sent to {m['label']}, from {who}")
                return self.redirect("/")
            log(f"could not shut down {m['label']}: {problem}")
            return self.send(HTTPStatus.INTERNAL_SERVER_ERROR,
                             self.server.main_page(f"Could not shut down {m['label']}: {problem}"))
        name = path.removeprefix("/wake/")
        m = self.server.watcher.machine(name) if path.startswith("/wake/") else None
        if not m:
            return self.not_found()
        if wake(m["mac"]):
            self.server.watcher.woke(name)
            log(f"wake-up sent to {m['label']}, from {who}")
            return self.redirect("/")
        log(f"could not send the wake-up to {m['label']}")
        self.send(HTTPStatus.INTERNAL_SERVER_ERROR, self.server.main_page(f"Could not send the wake-up to {m['label']}."))

    def login(self, password):
        stored = read_password()
        with self.server.login_lock:           # one try at a time, and a wrong one costs a second
            ok = bool(stored) and password_ok(password, stored)
            if not ok:
                time.sleep(1)
        if not ok:
            log(f"wrong password from {self.client_address[0]}")
            return self.send(HTTPStatus.FORBIDDEN, login_page("Wrong password."))
        cookie = make_cookie(self.server.secret, stored, time.time())
        self.redirect("/", [("Set-Cookie", COOKIE.format(cookie, SESSION_DAYS * 86400))])


class Server(ThreadingHTTPServer):
    def __init__(self, addr, tls, watcher, secret, cert_until):
        super().__init__(addr, Handler)
        self.tls, self.watcher, self.secret, self.cert_until = tls, watcher, secret, cert_until
        self.login_lock = threading.Lock()

    def finish_request(self, request, client_address):
        # The TLS handshake runs here, in the connection's own thread, so a slow
        # or refusing client cannot hold up the others.
        request.settimeout(30)
        try:
            conn = self.tls.wrap_socket(request, server_side=True)
        except (ssl.SSLError, OSError):
            return      # plain http://, or a browser that does not trust the certificate yet
        try:
            self.RequestHandlerClass(conn, client_address, self)
        finally:
            conn.close()

    def handle_error(self, request, client_address):
        log(f"request from {client_address[0]} failed: {sys.exc_info()[1]!r}")

    def main_page(self, error=""):
        return main_page(*self.watcher.snapshot(), time.time(), self.cert_until, error)


def cert_expiry():
    try:
        out = subprocess.run(["openssl", "x509", "-noout", "-enddate", "-in", str(CERT)],
                             capture_output=True, text=True, timeout=10).stdout
        return ssl.cert_time_to_seconds(out.strip().partition("=")[2])
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def serve():
    missing = [str(f) for f in (CERT, KEY, CA, DIR / "password") if not f.is_file()]
    if missing:
        log(f"missing: {', '.join(missing)}; see README, The wake page")
        sys.exit(2)     # wake-page.service does not restart on 2: waiting will not fix this
    try:
        watcher = Watcher(DIR)
    except (OSError, ValueError) as e:
        log(f"cannot read the devices: {e}. Fix machines.json, or move it away to start from the defaults.")
        sys.exit(2)
    tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    tls.minimum_version = ssl.TLSVersion.TLSv1_2
    tls.load_cert_chain(CERT, KEY)
    server = Server((BIND, PORT), tls, watcher, load_secret(), cert_expiry())
    watcher.start()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    log(f"listening on https://{BIND}:{PORT}")
    try:
        server.serve_forever()
    finally:
        watcher.save()


# --- setting it up ---------------------------------------------------------

def set_password():
    DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if sys.stdin.isatty():
        password = getpass.getpass("New password for the wake page: ")
        if getpass.getpass("Once more: ") != password:
            sys.exit("The two did not match; nothing changed.")
    else:
        password = sys.stdin.readline().rstrip("\n")       # for scripts and the tests
    if len(password) < 8:
        sys.exit("Use at least 8 characters; nothing changed.")
    write_private(DIR / "password", hash_password(password) + "\n")
    print("Password set. Devices that were logged in have to log in again.")


def main():
    p = argparse.ArgumentParser(description="The wake page; see README, The wake page.")
    p.add_argument("--set-password", action="store_true", help="ask for the password; only a hash is kept")
    if p.parse_args().set_password:
        set_password()
    else:
        serve()


if __name__ == "__main__":
    main()
