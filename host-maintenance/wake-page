def log(msg):
    print(msg, file=sys.stderr, flush=True)


def write_private(path, text):
    tmp = path.with_name(path.name + ".tmp")
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write(text)
    os.replace(tmp, path)


# --- the devices -----------------------------------------------------------

MAC_RE = re.compile(r"(?:[0-9A-Fa-f]{2}[:-]?){5}[0-9A-Fa-f]{2}")


def normal_mac(mac):
    hexes = re.sub(r"[^0-9A-Fa-f]", "", mac).upper()
    return ":".join(hexes[i:i + 2] for i in range(0, 12, 2))


def clean_device(label, ip, mac, check):
    """A device's fields, tidied, or a ValueError that says what to fix. An
    empty MAC stays empty: the page looks it up."""
    label = " ".join(str(label).split())
    if not 1 <= len(label) <= 40 or not label.isprintable():
        raise ValueError("Give it a name of up to 40 characters.")
    try:
        addr = ipaddress.IPv4Address(str(ip).strip())
    except ValueError:
        raise ValueError("The IP address should look like 192.168.50.23.") from None
    if addr not in LAN or addr in (LAN.network_address, LAN.broadcast_address):
        raise ValueError(f"The IP address has to be on the home network, {LAN}.")
    mac = str(mac).strip()
    if mac:
        if not MAC_RE.fullmatch(mac):
            raise ValueError("The MAC address should look like 02:00:00:00:00:20.")
        mac = normal_mac(mac)
        if int(mac[:2], 16) & 1:
            raise ValueError("That MAC address is for a group of devices, not for one.")
    if check not in ("ping", "arp"):
        raise ValueError("Choose how the page tells it is on: ping or ARP.")
    return label, str(addr), mac, check


def moved(url, old_ip, new_ip):
    """A site check's address, moved to the device's new IP if it used the old one."""
    parts = urllib.parse.urlsplit(url)
    if parts.hostname != old_ip:
        return url
    return urllib.parse.urlunsplit(parts._replace(netloc=new_ip + (f":{parts.port}" if parts.port else "")))


def slug(label, taken):
    base = re.sub(r"[^a-z0-9]+", "-", label.lower()).strip("-")[:30].strip("-") or "device"
    name, n = base, 2
    while name in taken:
        name, n = f"{base}-{n}", n + 1
    return name


def load_machines(path):
    """The devices in machines.json; a first start writes the defaults there.
    A broken file is a ValueError, and the page does not overwrite it."""
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        write_private(path, json.dumps(DEFAULT_MACHINES, indent=2) + "\n")
        return copy.deepcopy(DEFAULT_MACHINES)
    if not isinstance(data, dict):
        raise ValueError(f"{path} does not hold a list of devices")
    for name, m in data.items():
        try:
            if not re.fullmatch(r"[a-z0-9-]{1,40}", name):
                raise ValueError("the name may only have a-z, 0-9 and -")
            if not clean_device(m["label"], m["ip"], m["mac"], m["check"])[2]:
                raise ValueError("no MAC address")
            if not isinstance(m.get("services", {}), dict):
                raise ValueError("services must be names and addresses")
            if "shutdown" in m and not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", str(m["shutdown"])):
                raise ValueError("shutdown must be the user to log in as on the device")
        except (ValueError, LookupError, TypeError) as e:
            raise ValueError(f"{path}, device {name!r}: {e}") from None
    return data


# --- checking them ---------------------------------------------------------

def run(*cmd):
    """A command's exit status, or None when it could not run."""
    try:
        return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20).returncode
    except (OSError, subprocess.SubprocessError):
        return None


def neighbour(ip):
    """The kernel's ARP entry for an address: its state and MAC, or Nones."""
    try:
        out = subprocess.run(["ip", "-j", "neigh", "show", ip], capture_output=True, text=True, timeout=10).stdout
        entry = json.loads(out)[0]
        return entry["state"][0], entry.get("lladdr")
    except (OSError, subprocess.SubprocessError, ValueError, LookupError, TypeError, AttributeError):
        return None, None


def is_on(ip, how):
    """True or False, or None when this check cannot tell."""
    rc = run("ping", "-c", "1", "-W", "1", "-q", ip)
    if rc == 0:
        return True
    if rc != 1:                    # ping itself failed
        return None
    if how == "ping":
        return False
    # The ping made the kernel check its ARP entry for the device; wait for
    # the verdict. REACHABLE: it answered ARP in the last half minute or so.
    # FAILED: nothing answered.
    for _ in range(ARP_WAIT_SECS):
        state = neighbour(ip)[0]
        if state in ("REACHABLE", "FAILED"):
            return state == "REACHABLE"
        time.sleep(1)
    return None


def look_at(ip):
    """Ping a device once and wait for its ARP entry: whether it answers ping,
    and its MAC if anything at all answered at that address."""
    pinged = run("ping", "-c", "1", "-W", "1", "-q", ip) == 0
    for _ in range(ARP_WAIT_SECS):
        state, mac = neighbour(ip)
        if pinged or state in ("REACHABLE", "FAILED"):
            break
        time.sleep(1)
    return pinged, (mac if pinged or state == "REACHABLE" else None)


def service_up(url):
    """Whether a web service answers, and is not in maintenance (Nextcloud).
    Nothing secret is sent, so its certificate is not checked: the desktop's
    Nextcloud still has one of its own."""
    tls = ssl.create_default_context()
    tls.check_hostname = False
    tls.verify_mode = ssl.CERT_NONE
    try:
        with urllib.request.urlopen(url, timeout=5, context=tls) as r:
            body = r.read(65536)
    except (OSError, ValueError, http.client.HTTPException):
        return False
    try:
        data = json.loads(body)
    except ValueError:
        return True
    return not (isinstance(data, dict) and data.get("maintenance"))


def wake(mac):
    return run("wakeonlan", "-i", BROADCAST, mac) == 0


def shut_down(user, ip):
    """Switch a device off: an SSH login with the page's key, which the device's
    authorized_keys allows to run nothing but its shutdown (a forced command).
    None when that went out, otherwise what went wrong."""
    if not SHUTDOWN_KEY.is_file():
        return "the page has no shut-down key (README, The wake page)"
    cmd = ["ssh", "-F", "none", "-T", "-i", str(SHUTDOWN_KEY), "-o", "IdentitiesOnly=yes",
           "-o", "IdentityAgent=none", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
           "-o", "StrictHostKeyChecking=accept-new", "-o", f"UserKnownHostsFile={KNOWN_HOSTS}",
           "-l", user, ip]
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        return str(e)
    # a machine on its way down may close the session before it reports back
    if r.returncode == 0 or "closed by remote host" in r.stderr:
        return None
    lines = [line.strip() for line in r.stderr.splitlines() if line.strip()]
    return lines[-1] if lines else f"ssh ended with {r.returncode}"


def new_state():
    return {"on": None, "since": None, "exact": False, "wake": None, "halt": None, "services": {}}


class Watcher:
    """Knows the devices, checks each in a thread of its own, and remembers
    since when each one is on or off."""

    def __init__(self, directory):
        self.machines_path = directory / "machines.json"
        self.state_path = directory / "state.json"
        self.lock = threading.Lock()
        self.machines = load_machines(self.machines_path)
        self.state = {n: new_state() for n in self.machines}
        self.misses = {}
        self.threads = {}           # name: the token of the one thread that checks it
        self.saved = 0.0
        try:
            data = json.loads(self.state_path.read_text())
            fresh = time.time() - data["checked"] < GAP_SECS
        except (OSError, ValueError, LookupError, TypeError):
            return
        for n, s in self.state.items():
            old = data.get(n) or {}
            if fresh:
                s.update((k, old[k]) for k in s if k in old)
            else:          # away too long to know what happened meanwhile
                s["wake"] = old.get("wake")

    def start(self):
        with self.lock:
            for name in self.machines:
                self._start(name)

    def _start(self, name):             # with the lock held
        token = object()
        self.threads[name] = token
        threading.Thread(target=self.watch, args=(name, token), daemon=True).start()

    def _current(self, name, token):    # with the lock held
        return name in self.state and (token is None or self.threads.get(name) is token)

    def machine(self, name):
        with self.lock:
            m = self.machines.get(name)
            return copy.deepcopy(m) if m else None

    @staticmethod
    def _fields(label, ip, mac, check):
        """clean_device, with the MAC looked up when it was left empty."""
        label, ip, mac, check = clean_device(label, ip, mac, check)
        if not mac:
            pinged, found = look_at(ip)
            if not found:
                raise ValueError(f"Nothing answered at {ip}, so its MAC address could not be looked up. "
                                 "Is it on? Or type the MAC address in.")
            if check == "ping" and not pinged:
                raise ValueError(f"{ip} is there but does not answer ping (a firewall, like Windows'): "
                                 "choose ARP.")
            mac = normal_mac(found)
        return label, ip, mac, check

    def _unique(self, label, ip, mac, other_than=None):     # with the lock held
        for n, m in self.machines.items():
            if n == other_than:
                continue
            if m["label"].casefold() == label.casefold():
                raise ValueError(f"There is a device called {m['label']} already.")
            if m["ip"] == ip:
                raise ValueError(f"{m['label']} has that IP address already.")
            if m["mac"] == mac:
                raise ValueError(f"{m['label']} has that MAC address already.")

    def add(self, label, ip, mac, check):
        """Add a device and start checking it. Returns its name and entry; a
        ValueError says what to fix, an OSError that the list could not be saved."""
        label, ip, mac, check = self._fields(label, ip, mac, check)
        with self.lock:
            if len(self.machines) >= MAX_MACHINES:
                raise ValueError(f"The page takes up to {MAX_MACHINES} devices.")
            self._unique(label, ip, mac)
            name = slug(label, self.machines)
            entry = {"label": label, "ip": ip, "mac": mac, "check": check}
            machines = dict(self.machines, **{name: entry})
            self._save_machines(machines)       # nothing changes if this fails
            self.machines = machines
            self.state[name] = new_state()
            self._start(name)
        return name, dict(entry)

    def edit(self, name, label, ip, mac, check):
        """Change a device. It keeps its place on the list, its address on the
        page and its site checks, which move along if the IP changes. Returns
        the old and the new entry: a LookupError when there is no such device,
        a ValueError says what to fix, an OSError that the list could not be saved."""
        if self.machine(name) is None:
            raise LookupError(name)
        label, ip, mac, check = self._fields(label, ip, mac, check)
        with self.lock:
            old = self.machines.get(name)
            if old is None:
                raise LookupError(name)
            self._unique(label, ip, mac, other_than=name)
            new = dict(old, label=label, ip=ip, mac=mac, check=check)
            if old.get("services") and ip != old["ip"]:
                new["services"] = {s: moved(u, old["ip"], ip) for s, u in old["services"].items()}
            machines = dict(self.machines)
            machines[name] = new
            self._save_machines(machines)       # nothing changes if this fails
            self.machines = machines
            if (ip, check) != (old["ip"], old["check"]):
                # another address, or another way to check it: what the page
                # knew about it no longer holds, and a new thread checks it
                self.state[name] = new_state()
                self.misses.pop(name, None)
                self._start(name)
        self.save()
        return copy.deepcopy(old), copy.deepcopy(new)

    def remove(self, name):
        """Take a device off the list. Returns its entry, or None if there was none."""
        with self.lock:
            if name not in self.machines:
                return None
            machines = {k: v for k, v in self.machines.items() if k != name}
            self._save_machines(machines)
            entry = self.machines[name]
            self.machines = machines
            for d in (self.state, self.misses, self.threads):     # its thread sees it is gone
                d.pop(name, None)
        self.save()
        return entry

    def _save_machines(self, machines):  # with the lock held
        write_private(self.machines_path, json.dumps(machines, indent=2) + "\n")

    def record(self, name, on, now=None, token=None):
        """Take one check's answer (True, False or None) and save any change."""
        now = time.time() if now is None else now
        flip = None
        with self.lock:
            if not self._current(name, token):
                return                  # removed meanwhile, or added again
            s = self.state[name]
            if on:
                self.misses.pop(name, None)
                if s["on"] is not True:
                    flip = (True, now)
            elif on is False:
                count, first = self.misses.get(name, (0, now))
                self.misses[name] = (count + 1, first)
                if s["on"] is None or (s["on"] and count + 1 >= OFF_AFTER):
                    flip = (False, first)
            if flip:
                # exact: a check saw it the other way first. Right after a
                # start the page only knows "at least".
                s.update(on=flip[0], since=flip[1], exact=s["on"] is not None)
            label = self.machines[name]["label"]
        if flip:
            log(f"{label} is {'on' if flip[0] else 'off'}")
        if flip or now - self.saved >= 300:
            self.save(now)       # also every 5 min, so a restart can tell how long it was away

    def record_services(self, name, services, token=None):
        with self.lock:
            if self._current(name, token):
                self.state[name]["services"] = services

    def woke(self, name):
        with self.lock:
            if name in self.state:
                self.state[name]["wake"] = time.time()
        self.save()

    def halted(self, name):
        with self.lock:
            if name in self.state:
                self.state[name]["halt"] = time.time()
        self.save()

    def save(self, now=None):
        with self.lock:
            self.saved = time.time() if now is None else now
            try:
                write_private(self.state_path, json.dumps(dict(self.state, checked=self.saved)))
            except OSError as e:
                log(f"could not save {self.state_path}: {e}")

    def snapshot(self):
        with self.lock:
            return copy.deepcopy(self.machines), copy.deepcopy(self.state)

    def watch(self, name, token):
        while True:
            with self.lock:
                if not self._current(name, token):
                    return              # removed, or added again with a thread of its own
                m = copy.deepcopy(self.machines[name])
            try:
                on = is_on(m["ip"], m["check"])
                self.record(name, on, token=token)
                self.record_services(name, {s: service_up(u) for s, u in m.get("services", {}).items()}
                                     if on else {}, token)
            except Exception as e:           # one bad check must not end the watching
                log(f"checking {m['label']} failed: {e!r}")
            time.sleep(CHECK_SECS)


# --- what the page says ---------------------------------------------------

def span(secs):
    m = max(0, int(secs // 60))
    if m < 60:
        return f"{m} min" if m else "less than a minute"
    h, m = divmod(m, 60)
    if h < 24:
        return f"{h} h {m} min" if m else f"{h} h"
    d, h = divmod(h, 24)
    return (f"{d} day" if d == 1 else f"{d} days") + (f" {h} h" if h else "")


def describe(s, now):
    if s["on"] is None:
        return "Checking…"
    text = "On" if s["on"] else "Off"
    if s["since"] is None or (not s["exact"] and now - s["since"] < 60):
        return text
    return f"{text} for {'' if s['exact'] else 'at least '}{span(now - s['since'])}"


def wake_note(s, now):
    """What became of the last wake-up, while the device has not answered."""
    w = s.get("wake")
    if s["on"] or not w or now - w > 10 * 60 or (s["since"] or 0) > w:   # off again since: old news
        return ""
    if now - w < WAKE_WAIT_SECS:
        return f"Wake-up sent {span(now - w)} ago, waiting for it to answer."
    return f"Still no answer {span(now - w)} after the wake-up."


def halt_note(s, now):
    """What became of the last shut-down, while the device still answers."""
    h = s.get("halt")
    if not s["on"] or not h or now - h > 10 * 60 or (s["since"] or 0) > h:   # on again since: old news
        return ""
    if now - h < WAKE_WAIT_SECS:
        return f"Shut-down sent {span(now - h)} ago, waiting for it to go off."
    return f"Still on {span(now - h)} after the shut-down."


def state_html(s, now):
    """The state line: a chip saying on or off, then for how long."""
    text = describe(s, now)
    if s["on"] is None:
        return f'<span class="chip"><i></i>{text}</span>'
    word = "On" if s["on"] else "Off"
    return f'<span class="chip{" on" if s["on"] else ""}"><i></i>{word}</span>{html.escape(text[len(word):])}'


def services_line(s):
    if not s["on"] or not s.get("services"):
        return ""
    return "".join(f'<span class="{"ok" if up else "bad"}">{"✓" if up else "✗"} {html.escape(name)}</span>'
                   for name, up in s["services"].items())


def day(t):
    return time.strftime("%-d %b %Y", time.gmtime(t))


